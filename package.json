{
  "name": "vibe-project-harness",
  "version": "0.1.0",
  "private": true,
  "description": "Local AI engineering control core for Vibecoding projects",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @vibe-project-harness/desktop",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  }
}
